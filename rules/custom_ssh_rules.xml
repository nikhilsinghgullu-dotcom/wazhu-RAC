
<group name="custom_ssh,">

  <rule id="100100" level="5">
    <if_group>sshd</if_group>
    <match>Failed password</match>
    <description>SSH authentication failure detected</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100101" level="10" frequency="5" timeframe="120">
    <if_matched_sid>100100</if_matched_sid>
    <same_srcip />
    <description>Multiple SSH authentication failures from the same source IP</description>
    <group>authentication_failed,brute_force,</group>
  </rule>

</group>
