
<group name="custom_rdp,">

  <!-- RDP authentication failure -->
  <rule id="100200" level="5">
    <if_group>authentication_failed</if_group>
    <match>Logon Type: 10</match>
    <description>RDP authentication failure detected</description>
    <group>authentication_failed,rdp,</group>
  </rule>

  <!-- Multiple RDP authentication failures -->
  <rule id="100201" level="10" frequency="5" timeframe="120">
    <if_matched_sid>100200</if_matched_sid>
    <same_srcip />
    <description>Multiple RDP authentication failures from the same source IP</description>
    <group>authentication_failed,rdp,brute_force,</group>
  </rule>

</group>
